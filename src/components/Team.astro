---
import { Image } from 'astro:assets';
import { team } from '../content';
import stas from '../assets/team/stas.webp';
import filip from '../assets/team/filip.png';

const photos = { stas, filip } as const;
---
<section id="team" class="section team">
  <div class="wrap grid">
    <h2 class="h2">{team.heading}</h2>
    {team.people.map((p) => (
      <div class="person">
        <Image src={photos[p.photo as keyof typeof photos]} alt={`Portrait of ${p.name}`} width={192} height={192} widths={[96, 192]} sizes="96px" />
        <div class="who">
          <h3>{p.name}</h3>
          <p class="mono role">{p.role}</p>
          <a href={p.linkedin} rel="noopener" target="_blank">LinkedIn</a>
        </div>
      </div>
    ))}
  </div>
</section>

<style>
  .team { border-top: 1px solid var(--line); padding-block: 88px; }
  .grid { display: grid; grid-template-columns: repeat(auto-fit, minmax(min(320px, 100%), 1fr)); gap: 40px 64px; align-items: start; }
  .grid .h2 { font-size: 40px; }
  .person { display: flex; gap: 20px; align-items: center; }
  .person :global(img) { width: 96px; height: 96px; object-fit: cover; flex: none; filter: grayscale(1) contrast(1.05); }
  .who { display: flex; flex-direction: column; gap: 4px; min-width: 0; }
  h3 { font-weight: 700; font-size: 22px; }
  .role { font-size: 13px; color: var(--muted); }
  .who a { font-size: 15px; font-weight: 500; }
  @media (max-width: 640px) { .team { padding-block: 64px; } .grid .h2 { font-size: 30px; } }
</style>
