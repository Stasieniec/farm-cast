---
import { method } from '../content';
const tones = ['step--1', 'step--2', 'step--3'];
---
<section id="method" class="section">
  <div class="wrap stack">
    <div class="head-row">
      <h2 class="h2">{method.heading}</h2>
      <p class="lede">{method.lede}</p>
    </div>
    <ol>
      {method.steps.map((s, i) => (
        <li class={tones[i]}>
          <span class="mono tag">{s.tag}</span>
          <h3>{s.title}</h3>
          <p>{s.body}</p>
        </li>
      ))}
    </ol>
  </div>
</section>

<style>
  .stack { display: flex; flex-direction: column; gap: 48px; }
  ol { margin: 0; padding: 0; list-style: none; display: grid; grid-template-columns: repeat(auto-fit, minmax(min(280px, 100%), 1fr)); gap: 3px; }
  li { display: flex; flex-direction: column; gap: 10px; padding: 28px; }
  .tag { font-size: 13px; }
  h3 { font-weight: 700; font-size: 24px; }
  .step--1 { background: var(--g0); color: var(--ink); }
  .step--1 .tag, .step--1 p { color: var(--text-2); }
  .step--2 { background: var(--g2); color: var(--ink); }
  .step--2 .tag, .step--2 p { color: #22311c; }
  .step--3 { background: var(--g4); color: var(--ground); }
  .step--3 .tag { color: #dce6cc; }
  .step--3 p { color: var(--g0); }
</style>
