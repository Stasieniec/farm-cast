---
import { Image } from 'astro:assets';
import { work, site } from '../content';
import aerial from '../assets/work/aerial-fields.jpg';
import detector from '../assets/work/mushroom-detector.jpg';
import region from '../assets/work/region-fields.jpg';

const cards = [
  { img: aerial, alt: 'Close-up of potato fields from the air, coloured by satellite canopy greenness', tag: 'potato dry matter', before: 'Until now: found out at the weighbridge', now: 'Forecast per field, weeks before lifting', pos: '62% 30%' },
  { img: detector, alt: 'Mushroom caps outlined by the detector', tag: 'mushroom picking', before: 'Until now: judged by eye', now: 'Every cap measured, every hour', pos: '70% 50%' },
  { img: region, alt: 'Regional map with every potato field marked', tag: 'field yield', before: 'Until now: a few dug samples', now: 'Every field tracked from satellite, all season', pos: '75% 30%' },
];
---
<section id="work" class="section">
  <div class="wrap stack">
    <div class="head-row">
      <h2 class="h2">{work.heading}</h2>
      <p class="lede">{work.lede}</p>
    </div>
    <div class="cards">
      {cards.map((c) => (
        <article>
          <div class="pic">
            <Image src={c.img} alt={c.alt} widths={[400, 640, 900]} sizes="(max-width: 700px) 100vw, 33vw" style={`object-position:${c.pos}`} />
            <span class="tag mono">{c.tag}</span>
          </div>
          <div class="body">
            <span class="before mono">{c.before}</span>
            <h3>{c.now}</h3>
          </div>
        </article>
      ))}
    </div>
    <p class="more">{work.more} <a href={`mailto:${site.email}`}>{work.moreLink}</a></p>
  </div>
</section>

<style>
  .stack { display: flex; flex-direction: column; gap: 56px; }
  .cards { display: grid; grid-template-columns: repeat(auto-fit, minmax(min(320px, 100%), 1fr)); gap: 16px; }
  article { display: flex; flex-direction: column; background: var(--paper); border: 1px solid var(--line); border-radius: 6px; overflow: hidden; }
  .pic { position: relative; height: 240px; overflow: hidden; }
  .pic :global(img) { width: 100%; height: 100%; object-fit: cover; }
  .tag { position: absolute; left: 12px; top: 12px; padding: 4px 8px; background: var(--ink); color: var(--ground); font-size: 12px; }
  .body { display: flex; flex-direction: column; gap: 8px; padding: 22px; }
  .before { font-size: 13px; color: var(--muted); }
  h3 { font-weight: 700; font-size: 23px; line-height: 1.2; letter-spacing: -0.01em; }
  .more { font-size: 18px; border-top: 1px solid var(--line); padding-top: 24px; }
  .more a { font-weight: 500; }
</style>
