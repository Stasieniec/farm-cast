---
import '../styles/global.css';
import { site } from '../content';

const canonical = new URL(Astro.url.pathname, Astro.site);
const ogImage = new URL('/og.jpg', Astro.site);
// Cloudflare Web Analytics: cookieless, the token is public by design.
const cfBeacon = JSON.stringify({ token: '5f5859a2e4c14d3c93c9bfd5e71ead09' });
---
<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{site.title}</title>
    <meta name="description" content={site.description} />
    <link rel="canonical" href={canonical} />
    <link rel="icon" href="/favicon.ico" sizes="48x48" />
    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
    <link rel="apple-touch-icon" href="/apple-touch-icon.png" />
    <meta name="theme-color" content="#151912" />
    <meta property="og:type" content="website" />
    <meta property="og:site_name" content="farm-cast" />
    <meta property="og:title" content={site.title} />
    <meta property="og:description" content={site.description} />
    <meta property="og:url" content={canonical} />
    <meta property="og:image" content={ogImage} />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta property="og:image:alt" content="farm-cast: We measure what food production has always guessed." />
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:image" content={ogImage} />
  </head>
  <body>
    <a class="skip" href="#main">Skip to content</a>
    <slot />
    <script is:inline defer src="https://static.cloudflareinsights.com/beacon.min.js" data-cf-beacon={cfBeacon}></script>
  </body>
</html>
